SUPABASE_DB_URL=jdbc:postgresql://HOST-DEL-POOLER:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.PROJECT_REF
SUPABASE_DB_PASSWORD=REEMPLAZAR_CON_LA_CONTRASENA

# Usuario administrador inicial para probar los endpoints protegidos.
APP_ADMIN_EMAIL=admin@fastfood.com
APP_ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_SEGURA

# JWT de la API REST. Use una clave aleatoria de 32 caracteres o más.
JWT_SECRET=REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA_DE_32_CARACTERES_O_MAS
JWT_ISSUER=fast-food-api
JWT_EXPIRATION_MINUTES=60
