@baseUrl = http://localhost:8080
@productoId = 10
@clienteId = 1
@pedidoId = 1
@productoPedidoId = 1

# IMPORTANTE:
# 1. Ejecutamos el servidor Spring Boot con: .\mvnw.cmd spring-boot:run
# 2. Abrimos la colección de pruebas en Postman y reemplazamos {{baseUrl}} por http://localhost:8080 y {{productoId}} por 1.
# 3. Ejecuta estas solicitudes en el orden indicado.
# Los datos de ejecución se guardan permanentemente en Supabase.



### 1. POST correcto - debe responder 201 Created
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Hamburguesa clásica",
  "precio": 12.50,
  "stock": 20,
  "categoria": "HAMBURGUESAS"
}

### 2. POST incorrecto - debe responder 400 Bad Request
# El precio contiene texto y no puede convertirse a BigDecimal.
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Producto inválido",
  "precio": "doce con cincuenta",
  "stock": 10,
  "categoria": "HAMBURGUESAS"
}



### 3. GET correcto - debe responder 200 OK
GET {{baseUrl}}/api/productos/{{productoId}}

### 4. GET incorrecto - debe responder 404 Not Found
# La ruta solicitada no existe en ningún Controller.
GET {{baseUrl}}/api/ruta-inexistente



### 5. PUT correcto - debe responder 200 OK
PUT {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "nombre": "Hamburguesa clásica grande",
  "precio": 15.00,
  "stock": 15,
  "categoria": "HAMBURGUESAS"
}

### 6. PUT incorrecto - debe responder 400 Bad Request
# El stock contiene texto y no puede convertirse a un número entero.
PUT {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "nombre": "Hamburguesa inválida",
  "precio": 15.00,
  "stock": "stock-invalido",
  "categoria": "HAMBURGUESAS"
}



### 7. DELETE correcto - debe responder 204 No Content
DELETE {{baseUrl}}/api/productos/{{productoId}}

### 8. DELETE incorrecto - debe responder 404 Not Found
# La ruta solicitada no existe en ningún Controller.
DELETE {{baseUrl}}/api/ruta-inexistente/{{productoId}}


### 9. Listar productos después de eliminar - debe responder 200 con una lista vacía
GET {{baseUrl}}/api/productos


### 10. Registrar cliente - debe responder 201 Created
POST {{baseUrl}}/api/clientes
Content-Type: application/json

{
  "nombres": "Ana",
  "apellidos": "Pérez García",
  "telefono": "999111222",
  "correo": "ana.perez@correo.com",
  "direccion": "Av. Principal 123"
}

### 11. Listar clientes - debe responder 200 OK
GET {{baseUrl}}/api/clientes

### 12. Buscar clientes por apellido - consulta derivada
GET {{baseUrl}}/api/clientes/buscar?apellidos=Pérez

### 13. Buscar cliente por correo - consulta derivada
GET {{baseUrl}}/api/clientes/correo?correo=ana.perez@correo.com

### 14. Actualizar cliente - debe responder 200 OK
PUT {{baseUrl}}/api/clientes/{{clienteId}}
Content-Type: application/json

{
  "nombres": "Ana María",
  "apellidos": "Pérez García",
  "telefono": "999111222",
  "correo": "ana.perez@correo.com",
  "direccion": "Av. Nueva 456",
  "activo": true
}

### 15. Registrar pedido - primero debe existir el cliente indicado
POST {{baseUrl}}/api/pedidos
Content-Type: application/json

{
  "clienteId": {{clienteId}},
  "estado": "PENDIENTE",
  "total": 25.00,
  "tipoEntrega": "DOMICILIO",
  "direccionEntrega": "Av. Nueva 456",
  "observaciones": "Sin mayonesa"
}

### 16. Listar pedidos - debe responder 200 OK
GET {{baseUrl}}/api/pedidos

### 17. Buscar pedidos por cliente - consulta derivada
GET {{baseUrl}}/api/pedidos/cliente/{{clienteId}}

### 18. Buscar pedidos por estado - consulta derivada
GET {{baseUrl}}/api/pedidos/estado/PENDIENTE

### 19. Actualizar pedido - debe responder 200 OK
PUT {{baseUrl}}/api/pedidos/{{pedidoId}}
Content-Type: application/json

{
  "clienteId": {{clienteId}},
  "estado": "EN_PREPARACION",
  "total": 25.00,
  "tipoEntrega": "DOMICILIO",
  "direccionEntrega": "Av. Nueva 456",
  "observaciones": "Sin mayonesa"
}

# SEMANA 7 - JPQL Y TRANSACCIONES

### 22. Registrar producto para las consultas JPQL
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Hamburguesa BBQ",
  "precio": 18.50,
  "stock": 10,
  "categoria": "HAMBURGUESAS"
}

### 23. JPQL con parámetro: buscar por nombre
GET {{baseUrl}}/api/productos/buscar?nombre=hamburguesa

### 24. JPQL: productos con stock disponible
GET {{baseUrl}}/api/productos/disponibles

### 25. JPQL con múltiples condiciones: rango de precios y stock
GET {{baseUrl}}/api/productos/rango-precios?minimo=10&maximo=25

### 26. JPQL con ORDER BY: precio descendente
GET {{baseUrl}}/api/productos/ordenados-precio

### 27. Transacción individual exitosa: descontar stock
PUT {{baseUrl}}/api/productos/{{productoPedidoId}}/descontar-stock?cantidad=2

### 28. Transacción individual rechazada: debe responder 409 si no alcanza el stock
PUT {{baseUrl}}/api/productos/{{productoPedidoId}}/descontar-stock?cantidad=9999

### 29. Transacción grupal exitosa: registra pedido, detalle y descuenta stock
POST {{baseUrl}}/api/pedidos/procesar
Content-Type: application/json

{
  "clienteId": {{clienteId}},
  "tipoEntrega": "RECOJO",
  "observaciones": "Pedido de prueba semana 7",
  "detalles": [
    {
      "productoId": {{productoPedidoId}},
      "cantidad": 2
    }
  ]
}

### 30. JPQL sobre relación: detalles del pedido
GET {{baseUrl}}/api/pedidos/{{pedidoId}}/detalles

### 31. JPQL con SUM: total de pedidos pendientes
GET {{baseUrl}}/api/pedidos/total-por-estado/PENDIENTE

### 32. Rollback: debe responder 409 y no guardar pedido, detalle ni descuento
POST {{baseUrl}}/api/pedidos/procesar
Content-Type: application/json

{
  "clienteId": {{clienteId}},
  "tipoEntrega": "RECOJO",
  "observaciones": "Prueba de rollback",
  "detalles": [
    {
      "productoId": {{productoPedidoId}},
      "cantidad": 9999
    }
  ]
}

### 33. Eliminar pedido al finalizar todas las pruebas - debe responder 204
DELETE {{baseUrl}}/api/pedidos/{{pedidoId}}

### 34. Eliminar cliente después de eliminar sus pedidos - debe responder 204
DELETE {{baseUrl}}/api/clientes/{{clienteId}}
