@baseUrl = http://localhost:8080
@productoId = 10
@pedidoId = 1
@productoPedidoId = 1
@usuarioId = 1
@usuarioAdministrativoId = 2
@inventarioId = 1
@pagoId = 1
@pedidoProcesadoId = 2
@pedidoSinStockId = 3

# IMPORTANTE:
# 1. Ejecutamos el servidor Spring Boot con: .\mvnw.cmd spring-boot:run
# 2. Abrimos la colección de pruebas en Postman y reemplazamos {{baseUrl}} por http://localhost:8080 y {{productoId}} por 1.
# 3. Ejecuta estas solicitudes en el orden indicado.
# Los datos de ejecución se guardan permanentemente en Supabase.



### 1. POST correcto - debe responder 201 Created
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Hamburguesa clásica",
  "descripcion": "Carne, queso y verduras",
  "precio": 12.50,
  "stock": 20,
  "categoria": "HAMBURGUESAS"
}

### 2. POST incorrecto - debe responder 400 Bad Request
# El precio contiene texto y no puede convertirse a BigDecimal.
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Producto inválido",
  "precio": "doce con cincuenta",
  "stock": 10,
  "categoria": "HAMBURGUESAS"
}



### 3. GET correcto - debe responder 200 OK
GET {{baseUrl}}/api/productos/{{productoId}}

### 4. GET incorrecto - debe responder 404 Not Found
# La ruta solicitada no existe en ningún Controller.
GET {{baseUrl}}/api/ruta-inexistente



### 5. PUT correcto - debe responder 200 OK
PUT {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "nombre": "Hamburguesa clásica grande",
  "descripcion": "Carne grande, queso y verduras",
  "precio": 15.00,
  "stock": 15,
  "categoria": "HAMBURGUESAS"
}

### 6. PUT incorrecto - debe responder 400 Bad Request
# El stock contiene texto y no puede convertirse a un número entero.
PUT {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "nombre": "Hamburguesa inválida",
  "precio": 15.00,
  "stock": "stock-invalido",
  "categoria": "HAMBURGUESAS"
}



### 7. DELETE correcto - debe responder 204 No Content
DELETE {{baseUrl}}/api/productos/{{productoId}}

### 8. DELETE incorrecto - debe responder 404 Not Found
# La ruta solicitada no existe en ningún Controller.
DELETE {{baseUrl}}/api/ruta-inexistente/{{productoId}}


### 9. Listar productos después de eliminar - debe responder 200 con una lista vacía
GET {{baseUrl}}/api/productos


### 10. Registrar usuario cliente - el rol CLIENTE se asigna automáticamente
POST {{baseUrl}}/api/usuarios
Content-Type: application/json

{
  "nombre": "Ana Pérez García",
  "correo": "ana.perez@correo.com",
  "contrasena": "claveSegura123",
  "telefono": "999111222",
  "direccion": "Av. Principal 123",
  "rol": "ADMINISTRADOR"
}

### 11. Listar usuarios - debe responder 200 OK y Ana seguirá teniendo rol CLIENTE
GET {{baseUrl}}/api/usuarios

### 12. Buscar usuario por correo - consulta derivada
GET {{baseUrl}}/api/usuarios/correo?correo=ana.perez@correo.com

### 13. Actualizar usuario; este endpoint no permite cambiar su rol
PUT {{baseUrl}}/api/usuarios/{{usuarioId}}
Content-Type: application/json

{
  "nombre": "Ana María Pérez García",
  "correo": "ana.perez@correo.com",
  "telefono": "999111222",
  "direccion": "Av. Nueva 456",
  "activo": true
}

### 14. Registrar pedido - primero debe existir el usuario CLIENTE indicado
POST {{baseUrl}}/api/pedidos
Content-Type: application/json

{
  "usuario": {
    "id": {{usuarioId}}
  },
  "estado": "PENDIENTE",
  "subtotal": 20.00,
  "costoEntrega": 5.00,
  "total": 25.00,
  "tipoEntrega": "DOMICILIO",
  "direccionEntrega": "Av. Nueva 456",
  "observaciones": "Sin mayonesa"
}

### 15. Listar pedidos - debe responder 200 OK
GET {{baseUrl}}/api/pedidos

### 16. Buscar pedidos por usuario - consulta derivada
GET {{baseUrl}}/api/pedidos/usuario/{{usuarioId}}

### 17. Buscar pedidos por estado - consulta derivada
GET {{baseUrl}}/api/pedidos/estado/PENDIENTE

### 18. Actualizar pedido - debe responder 200 OK
PUT {{baseUrl}}/api/pedidos/{{pedidoId}}
Content-Type: application/json

{
  "usuario": {
    "id": {{usuarioId}}
  },
  "estado": "EN_PREPARACION",
  "subtotal": 20.00,
  "costoEntrega": 5.00,
  "total": 25.00,
  "tipoEntrega": "DOMICILIO",
  "direccionEntrega": "Av. Nueva 456",
  "observaciones": "Sin mayonesa"
}

# SEMANA 7 - JPQL Y TRANSACCIONES

### 22. Registrar producto para las consultas JPQL
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Hamburguesa BBQ",
  "descripcion": "Hamburguesa con salsa BBQ",
  "precio": 18.50,
  "stock": 10,
  "categoria": "HAMBURGUESAS"
}

### 23. JPQL con parámetro: buscar por nombre
GET {{baseUrl}}/api/productos/buscar?nombre=hamburguesa

### 24. JPQL: productos con stock disponible
GET {{baseUrl}}/api/productos/disponibles

### 25. JPQL con múltiples condiciones: rango de precios y stock
GET {{baseUrl}}/api/productos/rango-precios?minimo=10&maximo=25

### 26. JPQL con ORDER BY: precio descendente
GET {{baseUrl}}/api/productos/ordenados-precio

### 27. Transacción individual exitosa: descontar stock
PUT {{baseUrl}}/api/productos/{{productoPedidoId}}/descontar-stock?cantidad=2

### 28. Transacción individual rechazada: debe responder 409 si no alcanza el stock
PUT {{baseUrl}}/api/productos/{{productoPedidoId}}/descontar-stock?cantidad=9999

### 29. Crear pedido: registra pedido y detalle, pero todavía NO descuenta stock
POST {{baseUrl}}/api/pedidos/procesar
Content-Type: application/json

{
  "usuarioId": {{usuarioId}},
  "tipoEntrega": "RECOJO",
  "observaciones": "Pedido de prueba semana 7",
  "detalles": [
    {
      "productoId": {{productoPedidoId}},
      "cantidad": 2
    }
  ]
}

### 30. JPQL sobre relación: detalles del pedido pendiente
# Copia en pedidoProcesadoId el id devuelto por la solicitud 29.
GET {{baseUrl}}/api/pedidos/{{pedidoProcesadoId}}/detalles

### 31. JPQL con SUM: total de pedidos pendientes
GET {{baseUrl}}/api/pedidos/total-por-estado/PENDIENTE

### 32. Crear otro pedido con cantidad superior al stock: debe quedar PENDIENTE
POST {{baseUrl}}/api/pedidos/procesar
Content-Type: application/json

{
  "usuarioId": {{usuarioId}},
  "tipoEntrega": "RECOJO",
  "observaciones": "Prueba de rollback",
  "detalles": [
    {
      "productoId": {{productoPedidoId}},
      "cantidad": 9999
    }
  ]
}

### 33. Intentar pagar el pedido sin stock: debe responder 409 Conflict
# Copia en pedidoSinStockId el id devuelto por la solicitud 32.
# No se guarda el pago, el pedido continúa PENDIENTE y el stock no cambia.
POST {{baseUrl}}/api/pagos
Content-Type: application/json

{
  "pedido": {
    "id": {{pedidoSinStockId}}
  },
  "metodo": "YAPE",
  "monto": 184981.50
}

# TABLAS NUEVAS DEL SISTEMA

### 35. Listar categorías predeterminadas: hamburguesas, combos, piqueos y bebidas
GET {{baseUrl}}/api/categorias/activas

### 36. Registrar segundo usuario; aunque envíe un rol, se guardará como CLIENTE
POST {{baseUrl}}/api/usuarios
Content-Type: application/json

{
  "nombre": "Carlos Administrador",
  "correo": "admin@fastfood.com",
  "contrasena": "claveSegura123",
  "telefono": "999888777",
  "direccion": "Av. Administración 100",
  "rol": "ADMINISTRADOR"
}

### 37. Cambiar rol mediante el endpoint administrativo
PUT {{baseUrl}}/api/usuarios/{{usuarioAdministrativoId}}/rol
Content-Type: application/json

{
  "rol": "ADMINISTRADOR"
}

### 38. Consultar usuario por correo
GET {{baseUrl}}/api/usuarios/correo?correo=admin@fastfood.com

### 39. Configurar stock mínimo para un producto
POST {{baseUrl}}/api/inventarios
Content-Type: application/json

{
  "producto": {
    "id": {{productoPedidoId}}
  },
  "stockMinimo": 5
}

### 40. Consultar productos que llegaron al stock mínimo
GET {{baseUrl}}/api/inventarios/bajo-minimo

### 41. Confirmar el pedido con un pago simulado
# El monto debe coincidir con el total del pedido creado en la solicitud 29.
# Debe guardar APROBADO, cambiar el pedido a CONFIRMADO y descontar el stock.
POST {{baseUrl}}/api/pagos
Content-Type: application/json

{
  "pedido": {
    "id": {{pedidoProcesadoId}}
  },
  "metodo": "YAPE",
  "monto": 37.00
}

### 42. Consultar el pago asociado al pedido
GET {{baseUrl}}/api/pagos/pedido/{{pedidoProcesadoId}}

### 43. Pago duplicado: debe responder 409 Conflict
POST {{baseUrl}}/api/pagos
Content-Type: application/json

{
  "pedido": {
    "id": {{pedidoProcesadoId}}
  },
  "metodo": "EFECTIVO",
  "monto": 37.00
}

### 44. Eliminar pago al finalizar las pruebas - debe responder 204
DELETE {{baseUrl}}/api/pagos/{{pagoId}}

### 45. Eliminar configuración de inventario - debe responder 204
DELETE {{baseUrl}}/api/inventarios/{{inventarioId}}

### 46. Eliminar pedido después de eliminar su pago - debe responder 204
DELETE {{baseUrl}}/api/pedidos/{{pedidoId}}

### 47. Eliminar usuario después de eliminar sus pedidos - debe responder 204
DELETE {{baseUrl}}/api/usuarios/{{usuarioId}}
